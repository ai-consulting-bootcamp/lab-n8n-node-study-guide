{
  "name": "RAG Chatbot (with reranker)",
  "note": "Exported via n8n API (final version: answer-first lead capture). Credential IDs/names, webhook IDs and the Notion database ID removed.",
  "nodes": [
    {
      "name": "Upload Documents Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "parameters": {
        "formTitle": "Upload Documents for RAG",
        "formDescription": "Upload PDF, CSV, or JSON files to add to the knowledge base",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload Files",
              "fieldType": "file",
              "fieldName": "documents",
              "acceptFileTypes": ".pdf, .csv, .json"
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "name": "Store in Pinecone",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "value": "lagerflow-faq",
          "mode": "list"
        },
        "options": {}
      },
      "credentials": {
        "pineconeApi": "<redacted>"
      }
    },
    {
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "options": {
          "dimensions": 512
        }
      },
      "credentials": {
        "openAiApi": "<redacted>"
      }
    },
    {
      "name": "Document Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "parameters": {
        "dataType": "binary",
        "textSplittingMode": "custom",
        "options": {}
      }
    },
    {
      "name": "Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "parameters": {
        "options": {}
      }
    },
    {
      "name": "RAG Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful assistant that answers questions based ONLY on the retrieved document context. If the context does not contain enough information to answer the question confidently, respond with: \"I couldn't find that in our FAQ documents.\"\n\nLEAD CAPTURE (exception to the rule above): only if the user asks about pricing or has specific questions about the product, answer the questions from the doc, then ask if they would like the team to follow up! If the user confirms, collect these details in conversation: company name, contact email. Ask for whatever is missing. Only when you have BOTH details, call the Create a database page in Notion tool exactly once, add a summary about the in Inquiry field with a summary of the conversation.  Then confirm that the team will follow up. Never call the tool with missing or guessed details. Do not invent prices; answer from the documents only.",
          "enableStreaming": true
        }
      }
    },
    {
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.4-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "credentials": {
        "openAiApi": "<redacted>"
      }
    },
    {
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "parameters": {}
    },
    {
      "name": "Retrieve from Pinecone",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Retrieve relevant documents from the Pinecone vector store based on the user's query to answer questions about uploaded documents",
        "pineconeIndex": {
          "__rl": true,
          "value": "lagerflow-faq",
          "mode": "list"
        },
        "topK": 5,
        "useReranker": true,
        "options": {}
      },
      "credentials": {
        "pineconeApi": "<redacted>"
      }
    },
    {
      "name": "Query Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "options": {
          "dimensions": 512
        }
      },
      "credentials": {
        "openAiApi": "<redacted>"
      }
    },
    {
      "name": "Cohere Reranker",
      "type": "@n8n/n8n-nodes-langchain.rerankerCohere",
      "typeVersion": 1,
      "parameters": {},
      "credentials": {
        "cohereApi": "<redacted>"
      }
    },
    {
      "name": "Create a database page in Notion",
      "type": "n8n-nodes-base.notionTool",
      "typeVersion": 2.2,
      "parameters": {
        "resource": "databasePage",
        "databaseId": {
          "__rl": true,
          "value": "<redacted>",
          "mode": "id"
        },
        "title": "={{ $fromAI('company_name', 'The name of the company the user works for', 'string') }}",
        "simple": false,
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Contact Email|email",
              "emailValue": "={{ $fromAI('contact_email', 'The contact email address provided by the user', 'string') }}"
            },
            {
              "key": "Inquiry |rich_text",
              "textContent": "={{ $fromAI('inquiry', 'Short summary of what the user asked about (pricing or product)', 'string') }}"
            },
            {
              "key": "Date|date",
              "date": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "notionApi": "<redacted>"
      }
    },
    {
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "parameters": {
        "public": true,
        "initialMessages": "Hi there! How can i help you today.",
        "options": {}
      }
    }
  ],
  "connections": {
    "Upload Documents Form": {
      "main": [
        [
          {
            "node": "Store in Pinecone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Store in Pinecone",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Document Loader": {
      "ai_document": [
        [
          {
            "node": "Store in Pinecone",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Text Splitter": {
      "ai_textSplitter": [
        [
          {
            "node": "Document Loader",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Query Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Retrieve from Pinecone",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Cohere Reranker": {
      "ai_reranker": [
        [
          {
            "node": "Retrieve from Pinecone",
            "type": "ai_reranker",
            "index": 0
          }
        ]
      ]
    },
    "Retrieve from Pinecone": {
      "ai_tool": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Create a database page in Notion": {
      "ai_tool": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "When chat message received": {
      "main": [
        [
          {
            "node": "RAG Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
